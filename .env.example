# VAJRA OSINT — copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit it. Only this placeholder is committed.

# REQUIRED for any real use. Generate a permanent key with:
#   python generate_api_key.py
# (or: python -c "import secrets; print(secrets.token_urlsafe(32))")
# This key is what the dashboard/client sends as X-API-Key. It will NOT change
# across restarts once saved here.
VAJRA_API_KEY=replace-with-a-real-generated-key

# Comma-separated list of allowed CORS origins (no wildcard).
VAJRA_CORS_ORIGINS=http://localhost:3000

# Optional deployment safety: with VAJRA_ENV=production AND no VAJRA_API_KEY,
# api.py refuses to start instead of generating a throwaway key.
# VAJRA_ENV=production

# Bind address / port. Default host 127.0.0.1. 0.0.0.0 is honoured ONLY when
# VAJRA_ENV=production AND VAJRA_API_KEY is set.
# VAJRA_HOST=127.0.0.1
# VAJRA_PORT=8000

# Operator handle stamped on link reviews (link_reviews.reviewer).
# VAJRA_REVIEWER=ops

# Optional: point the app at a different SQLite file (default ./vajra.db).
# Useful to run an isolated instance or tests without touching the main DB.
# VAJRA_DB=C:\path\to\other.db